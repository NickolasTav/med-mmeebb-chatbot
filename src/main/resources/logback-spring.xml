<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="med-mmeebb-chatbot"/>
    <springProperty scope="context" name="lokiUrl" source="logging.loki.url" defaultValue="http://localhost:3100/loki/api/v1/push"/>

    <!-- Appender de Console (Terminal do IntelliJ) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%cyan(${appName}),%yellow(%X{traceId:-})] %green(%X{studentPhone:-}) %clr(%logger{36}){cyan} : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender do Grafana Loki - Focado exclusivamente em Logs Relevantes da Aplicação -->
    <springProfile name="!test">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>${lokiUrl}</url>
            </http>
            <format>
                <label>
                    <pattern>app=${appName},level=%level,logger=%logger{20}</pattern>
                </label>
                <message>
                    <pattern>[Trace: %X{traceId:-none}] [Aluno: %X{studentPhone:-N/A}] %msg</pattern>
                </message>
            </format>
        </appender>

        <!-- Apenas o pacote da aplicação envia logs INFO para o Loki -->
        <logger name="br.edu.unipam.tcc" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </logger>

        <!-- Frameworks e terceiros apenas enviam WARN e ERROR -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="org.apache" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
