# ========================================================
# Variáveis de Ambiente do Sistema - Chatbot MMEEBB
# Copie este arquivo para .env e ajuste os valores locais
# ========================================================

# Configurações da Aplicação
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Banco de Dados (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=med_mmeebb_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Mensageria (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Cache & Estado Conversacional (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Integração com API do UaiZap (WhatsApp)
UAIZAP_BASE_URL=https://api.uaizap.com.br
UAIZAP_TOKEN=seu_token_de_instancia_uaizap
UAIZAP_INSTANCE=unipam_med_bot
UAIZAP_WEBHOOK_SECRET=med_secret_key_123

# Inteligência Artificial - Google Gemini
GEMINI_API_KEY=sua_chave_de_api_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=10

# Túnel de Desenvolvimento Local (Ngrok / Pyngrok) - Opcional
NGROK_AUTHTOKEN=seu_authtoken_ngrok_aqui
NGROK_DOMAIN=seu-dominio-estatico.ngrok-free.app

